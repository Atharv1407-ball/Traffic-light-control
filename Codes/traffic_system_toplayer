`timescale 1ns / 1ps

module traffic_system(
    input wire clk,
    input wire reset,

    input wire EW_sensor,
    input wire NS_sensor,

    input wire emergency_NS,
    input wire emergency_EW,

    input wire ped_NS,
    input wire ped_EW,

    input wire maintenance_mode,

    input wire violation_sensor,   // NEW: basic sensor just past NS stop line

    output wire NS_red,
    output wire NS_yellow,
    output wire NS_green,

    output wire EW_red,
    output wire EW_yellow,
    output wire EW_green,

    output wire pedestrian_green,

    output wire violation_flag     // NEW: 1 = vehicle crossed NS stop line on red
);

wire [1:0] traffic_condition;

wire emergency_active;
wire emergency_override;
wire [1:0] emergency_direction;

wire [7:0] current_state;
wire [7:0] next_state;   // NEW: exposed for same-edge timer reset detection

wire min_green_done;
wire max_green_done;
wire right_turn_done;
wire yellow_done;
wire all_red_done;
wire emergency_buffer_done;

wire [1:0] emergency_dir;
wire emergency_restore_pending;

sensor_decoder sensor(
    .EW_sensor(EW_sensor),
    .NS_sensor(NS_sensor),
    .traffic_condition(traffic_condition)
);

emergency_controller emergency_ctrl(
    .emergency_NS(emergency_NS),
    .emergency_EW(emergency_EW),
    .maintenance_mode(maintenance_mode),
    .emergency_active(emergency_active),
    .emergency_override(emergency_override),
    .emergency_direction(emergency_direction)
);

traffic_fsm fsm(
    .clk(clk),
    .reset(reset),
    .traffic_condition(traffic_condition),
    .ped_request(ped_NS | ped_EW),
    .emergency(emergency_active),
    .min_green_done(min_green_done),
    .max_green_done(max_green_done),
    .right_turn_done(right_turn_done),
    .yellow_done(yellow_done),
    .all_red_done(all_red_done),
    .ped_done(1'b0),
    .emergency_buffer_done(emergency_buffer_done),
    .emergency_direction(emergency_direction),
    .emergency_dir(emergency_dir),
    .emergency_restore_pending(emergency_restore_pending),
    .current_state(current_state),
    .next_state(next_state)
);

traffic_timer timer(
    .clk(clk),
    .reset(reset),
    .current_state(current_state),
    .next_state(next_state),
    .emergency(emergency_active),
    .emergency_restore_pending(emergency_restore_pending),
    .emergency_dir(emergency_dir),
    .min_green_done(min_green_done),
    .max_green_done(max_green_done),
    .right_turn_done(right_turn_done),
    .yellow_done(yellow_done),
    .all_red_done(all_red_done),
    .emergency_buffer_done(emergency_buffer_done)
);

light_output_decode lights(
    .state(current_state),
    .emergency_dir(emergency_dir),
    .NS_red(NS_red),
    .NS_yellow(NS_yellow),
    .NS_green(NS_green),
    .EW_red(EW_red),
    .EW_yellow(EW_yellow),
    .EW_green(EW_green),
    .pedestrian_green(pedestrian_green)
);

// NEW: basic single-sensor red-light violation detector (NS direction only)
violation_detector viol(
    .clk(clk),
    .reset(reset),
    .NS_red(NS_red),
    .violation_sensor(violation_sensor),
    .violation_flag(violation_flag)
);

endmodule
